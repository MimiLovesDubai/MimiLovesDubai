# ============================================================
# MyAIAgent OS — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ============================================================

# --- Supabase (required) -----------------------------------
# Project URL + anon key: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Service role key (server-only; used for Stripe webhook + admin page).
# Keep secret. Supabase Dashboard -> Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic / Claude (required for AI agents) ------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional model override (default: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# --- Stripe (optional in development) ------------------------
# Without these keys the app runs fine; the checkout button
# explains that billing is not configured yet (dev fallback).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs (Stripe Dashboard -> Products -> Price)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# --- App ------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that may open /dashboard/admin
ADMIN_EMAILS=you@example.com
