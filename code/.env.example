# Kopieer dit bestand naar .env en vul je echte sleutels in.
#   cp .env.example .env
# Het echte .env-bestand staat in .gitignore en wordt nooit gecommit.

# Verplicht — haal op via https://console.anthropic.com (API Keys)
ANTHROPIC_API_KEY=sk-ant-vul-hier-je-sleutel-in

# Optioneel — pas nodig vanaf module 09
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Guardrail: maximale uitgave (in USD) die je agent-scripts zichzelf opleggen.
# Dit is een zachte limiet in code; zet óók een harde limiet in de Anthropic-console.
MAX_DAGELIJKSE_KOSTEN_USD=5.00
